// Console variables (cvars) and console commands: registry, parser, built-ins.
// Pure logic, no raylib: the dedicated server uses it too.
//
// Names are case-insensitive. Strings handed to command callbacks are views into
// the text being executed: copy them if they must outlive the call.
module arena::cvar;
import std::io, std::io::file, std::collections::list, std::sort;

const int MAX_ARGS = 64;
const int MAX_EXEC_DEPTH = 16;
const String SAVE_HEADER = "// Generated by Baires Arena (save_archived). Put your own lines in autoexec.cfg.\n";

<* Behavior flags of a cvar. *>
bitstruct CvarFlags : char
{
	bool archive;   // saved by save_archived() as `seta`
	bool server;    // server setting, replicated to clients
	bool cheat;     // the console can change it only while sv_cheats is on
	bool readonly;  // the console cannot change it; code can (Cvar.set)
	bool user;      // created from the console, not registered by code (yet)
}

struct Cvar
{
	String name;
	String value;          // owned; valid until the next change
	String default_value;
	String help;
	float fval;            // value as float (0 when not numeric)
	int ival;              // value as int (truncated fval when not integral)
	CvarFlags flags;
	int modified;          // bumped on every change: compare to detect edits
}

alias CommandFn = fn void(String[] args, void* ctx);
alias PrintFn = fn void(String text);

struct Command @local
{
	String name;
	String help;
	CommandFn func;
	void* ctx;
}

struct Registry @local
{
	Allocator alloc;
	List{Cvar*} cvars;       // sorted by name, case-insensitive
	List{Command} commands;  // sorted by name, case-insensitive
	PrintFn printer;         // null = stdout
	int exec_depth;
	bool ready;
}

Registry reg @local;

// ---------------------------------------------------------------------------
// Lifecycle

<* Set up the registry and the built-in commands. Idempotent; mutators call it. *>
fn void init()
{
	if (reg.ready) return;
	reg.ready = true;
	reg.alloc = mem;
	reg.cvars.init(reg.alloc);
	reg.commands.init(reg.alloc);
	add_command("echo", &cmd_echo, "echo <text...>: print the text");
	add_command("set", &cmd_set, "set <cvar> <value>: set (or create) a cvar");
	add_command("seta", &cmd_seta, "seta <cvar> <value>: set a cvar and archive it");
	add_command("toggle", &cmd_toggle, "toggle <cvar> [v1 v2 ...]: flip 0/1 or cycle the values");
	add_command("cvarlist", &cmd_cvarlist, "cvarlist [prefix]: list cvars");
	add_command("cmdlist", &cmd_cmdlist, "cmdlist [prefix]: list commands");
	add_command("exec", &cmd_exec, "exec <file>: run a config file");
	add_command("help", &cmd_help, "help <name>: describe a command or cvar");
	register("sv_cheats", "0", "allow cheat-protected cvars", { .server });
}

<* Free every cvar and command. Pointers from register()/find() die here. *>
fn void shutdown()
{
	if (!reg.ready)
	{
		reg = {};
		return;
	}
	Allocator a = reg.alloc;
	foreach (cv : reg.cvars)
	{
		cv.name.free(a);
		cv.value.free(a);
		cv.default_value.free(a);
		cv.help.free(a);
		alloc::free(a, cv);
	}
	foreach (&c : reg.commands)
	{
		c.name.free(a);
		c.help.free(a);
	}
	reg.cvars.free();
	reg.commands.free();
	reg = {};
}

// ---------------------------------------------------------------------------
// Cvars

<*
 Register a cvar owned by code. Idempotent: returns the existing one.
 A value the user set earlier (autoexec, `seta` lines) is kept, unless the cvar
 is readonly or cheat-protected.

 @require is_valid_name(name) : "cvar names cannot be empty or contain spaces, quotes or ';'"
 @require !find_command(name) : "name already used by a command"
*>
fn Cvar* register(String name, String default_value, String help, CvarFlags flags = {})
{
	init();
	Cvar* cv = find(name);
	if (!cv) return insert_cvar(name, default_value, help, flags);
	if (!cv.flags.user) return cv;

	// Adopt the console-created cvar: code owns the definition from now on.
	bool archived = cv.flags.archive;
	cv.flags = flags;
	cv.flags.archive = flags.archive || archived;
	replace_str(&cv.default_value, default_value);
	replace_str(&cv.help, help);
	if (flags.readonly || (flags.cheat && !cheats_on())) cv.set(default_value);
	return cv;
}

<* Null if there is no cvar with that name. *>
fn Cvar* find(String name)
{
	Cvar*[] all = reg.cvars.array_view();
	sz i = lower_bound(all, name);
	if (i < all.len && compare_names(all[i].name, name) == 0) return all[i];
	return null;
}

<* Every cvar, sorted by name. The view dies when a cvar is added. *>
fn Cvar*[] all() => reg.cvars.array_view();

<*
 Console semantics: creates a user cvar when missing, refuses readonly and
 (without sv_cheats) cheat cvars. Code that owns a cvar uses Cvar.set instead.
*>
fn void set(String name, String value)
{
	init();
	Cvar* cv = find(name);
	if (cv)
	{
		console_set(cv, value);
		return;
	}
	if (!is_valid_name(name))
	{
		printf("invalid cvar name \"%s\"", name);
		return;
	}
	if (find_command(name))
	{
		printf("%s is a command, not a cvar", name);
		return;
	}
	insert_cvar(name, value, "", { .user });
}

<* Unconditional change (ignores flags). *>
fn void Cvar.set(&self, String value)
{
	if (self.value == value) return;
	store_value(self, value);
	self.modified++;
}

fn void Cvar.set_float(&self, float value) => @pool()
{
	self.set(string::tformat("%g", value));
}

fn void Cvar.set_int(&self, int value) => @pool()
{
	self.set(string::tformat("%d", value));
}

fn void Cvar.reset(&self) => self.set(self.default_value);

fn String Cvar.str(&self) => self.value;
fn float Cvar.num(&self) => self.fval;
fn int Cvar.integer(&self) => self.ival;
fn bool Cvar.on(&self) => self.fval != 0;

fn bool is_valid_name(String name)
{
	if (!name.len) return false;
	foreach (c : name)
	{
		if (c <= ' ' || c == '"' || c == ';') return false;
	}
	return true;
}

// ---------------------------------------------------------------------------
// Commands

<*
 Add a console command (re-adding a name replaces it). args[0] is the name.

 @require is_valid_name(name) : "command names cannot be empty or contain spaces, quotes or ';'"
 @require f != null : "missing command function"
 @require !find(name) : "name already used by a cvar"
*>
fn void add_command(String name, CommandFn f, String help, void* ctx = null)
{
	init();
	Command[] all = reg.commands.array_view();
	sz i = lower_bound(all, name);
	if (i < all.len && compare_names(all[i].name, name) == 0)
	{
		all[i].func = f;
		all[i].ctx = ctx;
		replace_str(&all[i].help, help);
		return;
	}
	Command c = { .name = name.copy(reg.alloc), .help = help.copy(reg.alloc), .func = f, .ctx = ctx };
	reg.commands.insert_at(i, c);
}

fn void remove_command(String name)
{
	Command* c = find_command(name);
	if (!c) return;
	sz i = c - reg.commands.entries;
	c.name.free(reg.alloc);
	c.help.free(reg.alloc);
	reg.commands.remove_at(i);
}

fn bool is_command(String name) => find_command(name) != null;

<* Sorted names of commands and cvars starting with prefix (case-insensitive).
   The array is allocated with `a`; the names are views, valid until shutdown. *>
fn String[] complete(String prefix, Allocator a)
{
	Command[] cmds = reg.commands.array_view();
	Cvar*[] cvars = reg.cvars.array_view();
	sz c0 = lower_bound(cmds, prefix);
	sz c_n = prefix_end(cmds, c0, prefix) - c0;
	sz v0 = lower_bound(cvars, prefix);
	sz v_n = prefix_end(cvars, v0, prefix) - v0;

	String[] out = alloc::new_array(a, String, c_n + v_n);
	foreach (i, c : cmds[c0:c_n]) out[i] = c.name;
	foreach (i, cv : cvars[v0:v_n]) out[c_n + i] = cv.name;
	quicksort(out, &compare_names);
	return out;
}

// ---------------------------------------------------------------------------
// Execution

<*
 Run console text: statements separated by ';' or newlines, "quoted args"
 (quotes never span lines), `//` comments up to the end of the line.
 `cmd args` calls the command, `cvar` prints it, `cvar value` sets it.
*>
fn void exec(String text)
{
	init();
	if (reg.exec_depth >= MAX_EXEC_DEPTH)
	{
		printf("exec: nested too deep (recursive exec?)");
		return;
	}
	reg.exec_depth++;
	defer reg.exec_depth--;

	sz start = 0;
	bool quoted = false;
	for (sz i = 0; i < text.len; i++)
	{
		char c = text[i];
		if (c == '"') quoted = !quoted;
		if (c == '\n') quoted = false;
		if (quoted) continue;
		if (c == '/' && i + 1 < text.len && text[i + 1] == '/')
		{
			run_statement(text[start:i - start]);
			i = text.index_of_char_from('\n', i) ?? text.len;
			start = i + 1;
			continue;
		}
		if (c != ';' && c != '\n') continue;
		run_statement(text[start:i - start]);
		start = i + 1;
	}
	if (start < text.len) run_statement(text[start..]);
}

<* Run a config file. False when it can't be read (a missing autoexec.cfg is fine). *>
fn bool exec_file(String path) => @pool()
{
	char[]? data = file::load_temp(path);
	if (catch data) return false;
	exec((String)data);
	return true;
}

<* Write `seta name "value"` for every archived cvar, sorted by name. *>
fn void? save_archived(String path) => @pool()
{
	DString out = dstring::temp(SAVE_HEADER);
	foreach (cv : reg.cvars)
	{
		if (!cv.flags.archive) continue;
		out.appendf("seta %s \"%s\"\n", cv.name, cv.value);
	}
	file::save(path, out.str_view())!;
}

<*
 Split one statement into args: whitespace separates, "quotes" group (and are
 stripped; an unclosed quote runs to the end). Returns views into `stmt`.
*>
fn String[] split_args(String stmt, String[] buf)
{
	sz n = 0;
	sz i = 0;
	while (n < buf.len)
	{
		while (i < stmt.len && stmt[i].is_space()) i++;
		if (i >= stmt.len) break;
		if (stmt[i] == '"')
		{
			sz close = stmt.index_of_char_from('"', i + 1) ?? stmt.len;
			buf[n++] = stmt[i + 1:close - i - 1];
			i = close + 1;
			continue;
		}
		sz start = i;
		while (i < stmt.len && !stmt[i].is_space() && stmt[i] != '"') i++;
		buf[n++] = stmt[start:i - start];
	}
	return buf[:n];
}

// ---------------------------------------------------------------------------
// Output

<* Where output goes (console UI, or stdout when null). One call = one line. *>
fn void set_printer(PrintFn f)
{
	reg.printer = f;
}

fn void print(String text)
{
	if (reg.printer)
	{
		reg.printer(text);
		return;
	}
	io::printn(text);
}

fn void printf(String fmt, args...) @format(0) => @pool()
{
	print(string::tformat(fmt, ...args));
}

// ---------------------------------------------------------------------------
// Internals

fn Cvar* insert_cvar(String name, String value, String help, CvarFlags flags) @local
{
	Allocator a = reg.alloc;
	Cvar* cv = alloc::new(a, Cvar);
	cv.name = name.copy(a);
	cv.default_value = value.copy(a);
	cv.help = help.copy(a);
	cv.flags = flags;
	store_value(cv, value);
	reg.cvars.insert_at(lower_bound(reg.cvars.array_view(), name), cv);
	return cv;
}

fn void store_value(Cvar* cv, String value) @local
{
	replace_str(&cv.value, value);
	cv.fval = value.to_float() ?? 0;
	cv.ival = value.to_int() ?? (int)cv.fval;
}

<* Copy first: `value` may alias the old string. *>
fn void replace_str(String* s, String value) @local
{
	String copy = value.copy(reg.alloc);
	s.free(reg.alloc);
	*s = copy;
}

fn void console_set(Cvar* cv, String value) @local
{
	if (cv.flags.readonly)
	{
		printf("%s is read only", cv.name);
		return;
	}
	if (cv.flags.cheat && !cheats_on())
	{
		printf("%s is cheat protected (sv_cheats is 0)", cv.name);
		return;
	}
	cv.set(value);
}

fn bool cheats_on() @local
{
	Cvar* cheats = find("sv_cheats");
	return cheats && cheats.on();
}

fn Command* find_command(String name) @local
{
	Command[] all = reg.commands.array_view();
	sz i = lower_bound(all, name);
	if (i < all.len && compare_names(all[i].name, name) == 0) return &all[i];
	return null;
}

fn void run_statement(String stmt) @local
{
	String[MAX_ARGS] buf;
	String[] args = split_args(stmt, &buf);
	if (!args.len) return;

	Command* cmd = find_command(args[0]);
	if (cmd)
	{
		// Copy: the command may add commands and move the list.
		Command c = *cmd;
		c.func(args, c.ctx);
		return;
	}
	Cvar* cv = find(args[0]);
	if (!cv)
	{
		printf("unknown command \"%s\"", args[0]);
		return;
	}
	if (args.len == 1)
	{
		print_cvar(cv);
		return;
	}
	console_set(cv, args[1]);
}

fn void print_cvar(Cvar* cv) @local
{
	printf("%s is \"%s\" (default \"%s\")%s%s", cv.name, cv.value, cv.default_value,
		cv.help.len ? " - " : "", cv.help);
}

<* Case-insensitive order with '_' before letters (stdlib's ignore_case upper-cases). *>
fn int compare_names(String a, String b) @local
{
	sz n = min(a.len, b.len);
	for (sz i = 0; i < n; i++)
	{
		int d = (int)a[i].to_lower() - (int)b[i].to_lower();
		if (d != 0) return d;
	}
	return (int)(a.len - b.len);
}

fn bool has_prefix(String name, String prefix) @local
{
	return name.len >= prefix.len && compare_names(name[:prefix.len], prefix) == 0;
}

<* First index whose name is >= `name` in a slice sorted by name. *>
macro sz lower_bound(slice, String name) @local
{
	sz lo = 0;
	sz hi = slice.len;
	while (lo < hi)
	{
		sz mid = lo + (hi - lo) / 2;
		if (compare_names(slice[mid].name, name) < 0)
		{
			lo = mid + 1;
			continue;
		}
		hi = mid;
	}
	return lo;
}

<* End of the run of names starting with `prefix`, beginning at `first`. *>
macro sz prefix_end(slice, sz first, String prefix) @local
{
	sz i = first;
	while (i < slice.len && has_prefix(slice[i].name, prefix)) i++;
	return i;
}

fn String flag_letters(CvarFlags f, char[] buf) @local
{
	buf[0] = f.archive ? 'A' : ' ';
	buf[1] = f.server ? 'S' : ' ';
	buf[2] = f.cheat ? 'C' : ' ';
	buf[3] = f.readonly ? 'R' : ' ';
	buf[4] = f.user ? 'U' : ' ';
	return (String)buf[:5];
}

// ---------------------------------------------------------------------------
// Built-in commands

fn void cmd_echo(String[] args, void* ctx) @local => @pool()
{
	print(string::tjoin(args[1..], " "));
}

fn void cmd_set(String[] args, void* ctx) @local
{
	if (args.len < 3)
	{
		printf("usage: %s <cvar> <value>", args[0]);
		return;
	}
	set(args[1], args[2]);
}

fn void cmd_seta(String[] args, void* ctx) @local
{
	cmd_set(args, ctx);
	if (args.len < 3) return;
	Cvar* cv = find(args[1]);
	if (cv && !cv.flags.readonly) cv.flags.archive = true;
}

fn void cmd_toggle(String[] args, void* ctx) @local
{
	if (args.len < 2)
	{
		printf("usage: toggle <cvar> [v1 v2 ...]");
		return;
	}
	Cvar* cv = find(args[1]);
	if (!cv)
	{
		printf("toggle: unknown cvar \"%s\"", args[1]);
		return;
	}
	if (args.len == 2)
	{
		console_set(cv, cv.on() ? "0" : "1");
		return;
	}
	// Cycle: the value after the current one, or the first if not in the list.
	String[] values = args[2..];
	sz next = 0;
	foreach (i, v : values)
	{
		if (compare_names(v, cv.value) == 0) next = (i + 1) % values.len;
	}
	console_set(cv, values[next]);
}

fn void cmd_cvarlist(String[] args, void* ctx) @local
{
	String prefix = args.len > 1 ? args[1] : "";
	Cvar*[] cvars = reg.cvars.array_view();
	sz first = lower_bound(cvars, prefix);
	sz n = prefix_end(cvars, first, prefix) - first;
	char[5] letters;
	foreach (cv : cvars[first:n])
	{
		printf("%s %s \"%s\"", flag_letters(cv.flags, &letters), cv.name, cv.value);
	}
	printf("%d cvars (A archive, S server, C cheat, R read only, U user)", n);
}

fn void cmd_cmdlist(String[] args, void* ctx) @local
{
	String prefix = args.len > 1 ? args[1] : "";
	Command[] cmds = reg.commands.array_view();
	sz first = lower_bound(cmds, prefix);
	sz n = prefix_end(cmds, first, prefix) - first;
	foreach (c : cmds[first:n])
	{
		printf("%s - %s", c.name, c.help);
	}
	printf("%d commands", n);
}

fn void cmd_exec(String[] args, void* ctx) @local
{
	if (args.len < 2)
	{
		printf("usage: exec <file>");
		return;
	}
	if (!exec_file(args[1])) printf("couldn't exec %s", args[1]);
}

fn void cmd_help(String[] args, void* ctx) @local
{
	if (args.len < 2)
	{
		printf("usage: help <name>  (cmdlist and cvarlist list them)");
		return;
	}
	Command* c = find_command(args[1]);
	if (c)
	{
		printf("%s - %s", c.name, c.help);
		return;
	}
	Cvar* cv = find(args[1]);
	if (!cv)
	{
		printf("help: nothing named \"%s\"", args[1]);
		return;
	}
	print_cvar(cv);
}
